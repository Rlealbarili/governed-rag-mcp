GOVERNED_RAG_CLIENT_PROFILE=restricted
GOVERNED_RAG_INDEX=data/knowledge.sqlite
GOVERNED_RAG_EMBEDDING_PROVIDER=hash
GOVERNED_RAG_HASH_DIMENSIONS=64

# Optional local Ollama provider. Keep the endpoint loopback-only by default.
OLLAMA_EMBEDDINGS_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
